<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules untuk Android API 31+.
   Exclude royaltree_app_prefs (onboarding, dark mode, bahasa)
   supaya onboarding muncul bila user install ulang.
   Firebase token tetap di-backup -> auto-login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="royaltree_app_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="royaltree_app_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
